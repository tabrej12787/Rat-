import { DuckDBInstance } from '@duckdb/node-api';

const HF_INDEX_BASE = (process.env.ICMR_HF_INDEX_BASE ||
  'https://huggingface.co/buckets/godhosting/bakchodipromax/resolve/main').replace(/\/$/, '');

const DUPLICATE_CAP = 2;
const TIMEOUT_DEFAULT = parseInt(process.env.ICMR_TIMEOUT || '25', 10);

const SEARCH_FIELDS = [
  'name', 'fathersName', 'phoneNumber', 'aadharNumber', 'otherNumber',
  'address', 'district', 'pincode', 'state', 'town', 'source',
];
const NUMBER_FIELDS = ['phoneNumber', 'aadharNumber', 'otherNumber'];

const REMOTE_INDEXES = {
  phone: Array.from({ length: 7 }, (_, i) => `${HF_INDEX_BASE}/idx_phone.${i}.parquet`),
  aadhar: Array.from({ length: 7 }, (_, i) => `${HF_INDEX_BASE}/idx_aadhar.${i}.parquet`),
};

let instance = null;
let conn = null;
const loadStatus = {
  phone_loaded: false,
  aadhar_loaded: false,
  error: null,
  init_time: null,
  details: {},
};

async function initConn() {
  if (conn) return conn;

  instance = await DuckDBInstance.create(':memory:');
  conn = await instance.connect();

  await conn.run(`SET home_directory='/tmp'`);
  await conn.run(`SET extension_directory='/tmp/duckdb_extensions'`);
  await conn.run(`SET threads=1`);
  await conn.run(`SET http_keep_alive=false`);
  await conn.run(`SET enable_http_metadata_cache=true`);

  try {
    await conn.run(`INSTALL parquet; LOAD parquet;`);
    await conn.run(`INSTALL httpfs; LOAD httpfs;`);
    loadStatus.details.extensions = 'loaded';
  } catch (e) {
    loadStatus.error = `Extension load failed: ${e.message}`;
    loadStatus.details.extensions = String(e.message).slice(0, 200);
  }

  for (const [kind, urls] of Object.entries(REMOTE_INDEXES)) {
    try {
      const test = await conn.run(
        `SELECT count(*) FROM read_parquet('${urls[0]}', union_by_name=true) LIMIT 1`
      );
      await test.getRowObjects();
      const list = urls.map((u) => `'${u}'`).join(', ');
      await conn.run(
        `CREATE OR REPLACE VIEW people_${kind} AS SELECT * FROM read_parquet([${list}], union_by_name=true)`
      );
      loadStatus[`${kind}_loaded`] = true;
      loadStatus.details[kind] = 'success';
    } catch (e) {
      loadStatus.details[kind] = String(e.message).slice(0, 200);
    }
  }

  loadStatus.init_time = Date.now() / 1000;
  return conn;
}

function ready(kind) {
  return !!loadStatus[`${kind}_loaded`];
}

function personKey(row) {
  const ph = (row.phoneNumber || '').toString().trim();
  const ad = (row.aadharNumber || '').toString().trim();
  if (ph || ad) return `${ph}|${ad}`;
  return `${(row.name || '').toString().trim()}|${(row.fathersName || '').toString().trim()}`;
}

function connectedNumbers(row) {
  const out = [];
  const seen = new Set();
  for (const f of NUMBER_FIELDS) {
    const v = row[f];
    if (!v) continue;
    const s = String(v).trim();
    if (s && !seen.has(s)) {
      seen.add(s);
      out.push({ field: f, value: s });
    }
  }
  return out;
}

function cap(rows) {
  const seen = {};
  const out = [];
  for (const r of rows) {
    const k = personKey(r);
    const n = seen[k] || 0;
    if (n < DUPLICATE_CAP) {
      seen[k] = n + 1;
      out.push({ ...r, connected_numbers: connectedNumbers(r) });
    }
  }
  return out;
}

async function fieldSearch(field, value, mode, limit) {
  if (!SEARCH_FIELDS.includes(field)) throw new Error(`Unknown field: ${field}`);
  const c = await initConn();
  const v = String(value).replace(/'/g, "''");

  let view = null;
  if (field === 'phoneNumber' && ready('phone')) view = 'people_phone';
  else if (field === 'aadharNumber' && ready('aadhar')) view = 'people_aadhar';
  else return { field, value, mode, count: 0, results: [] };

  let sql;
  if (mode === 'exact') {
    sql = `SELECT * FROM ${view} WHERE ${field} = '${v}' LIMIT ${limit * DUPLICATE_CAP + 20}`;
  } else {
    const v2 = v.replace(/%/g, '\\%').replace(/_/g, '\\_');
    sql = `SELECT * FROM ${view} WHERE ${field} ILIKE '%${v2}%' ESCAPE '\\' LIMIT ${limit * DUPLICATE_CAP + 20}`;
  }

  try {
    const reader = await c.runAndReadAll(sql);
    const rows = reader.getRowObjects();
    const results = cap(rows).slice(0, limit);
    return { field, value, mode, count: results.length, results };
  } catch (e) {
    return { field, value, mode, count: 0, results: [], error: e.message };
  }
}

async function unified(q, limit) {
  q = q.trim();
  if (!/^\d{8,}$/.test(q)) {
    return { query: q, searched_fields: [], count: 0, results: [] };
  }
  let rows = [];
  const searched = [];
  if (ready('phone')) {
    const r = await fieldSearch('phoneNumber', q, 'exact', limit);
    rows.push(...r.results);
    searched.push('phoneNumber');
  }
  if (rows.length === 0 && ready('aadhar')) {
    const r = await fieldSearch('aadharNumber', q, 'exact', limit);
    rows.push(...r.results);
    searched.push('aadharNumber');
  }
  rows = cap(rows).slice(0, limit);
  return { query: q, searched_fields: searched, count: rows.length, results: rows };
}

function jsonResponse(body, status = 200) {
  return new Response(JSON.stringify(body), {
    status,
    headers: { 'content-type': 'application/json', 'access-control-allow-origin': '*' },
  });
}

export const config = { runtime: 'edge' }; // Remove this line if using Node runtime

export default async function handler(req) {
  const url = new URL(req.url);
  const path = url.pathname;

  try {
    if (path === '/' || path === '') {
      return jsonResponse({
        app: 'Search API',
        author: 'Develop by Tridev Cyber Warrior',
        status: 'running',
        indexes: { phone: ready('phone'), aadhar: ready('aadhar') },
        load_status: loadStatus,
      });
    }

    if (path === '/health') {
      try {
        await initConn();
      } catch (e) {
        return jsonResponse({ status: 'error', error: e.message }, 500);
      }
      return jsonResponse({
        status: loadStatus.error ? 'degraded' : 'healthy',
        indexes: { phone: ready('phone'), aadhar: ready('aadhar') },
        load_status: loadStatus,
        timestamp: Date.now() / 1000,
      });
    }

    if (path === '/warmup') {
      try {
        await initConn();
      } catch (e) {
        return jsonResponse({ error: e.message }, 500);
      }
      return jsonResponse({
        status: 'warmed up',
        indexes: { phone: ready('phone'), aadhar: ready('aadhar') },
        load_status: loadStatus,
      });
    }

    if (path === '/search') {
      const q = (url.searchParams.get('q') || url.searchParams.get('mobile') || '').trim();
      if (!q) return jsonResponse({ error: "Provide 'q' or 'mobile'" }, 422);

      const field = url.searchParams.get('field');
      const mode = url.searchParams.get('mode') || 'exact';
      const limit = Math.min(Math.max(parseInt(url.searchParams.get('limit') || '10', 10), 1), 200);
      const timeout = Math.min(Math.max(parseInt(url.searchParams.get('timeout') || String(TIMEOUT_DEFAULT), 10), 5), 60);

      let data;
      try {
        const work = field ? fieldSearch(field, q, mode, limit) : unified(q, limit);
        data = await Promise.race([
          work,
          new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), timeout * 1000)),
        ]);
      } catch (e) {
        const status = e.message === 'timeout' ? 504 : 500;
        return jsonResponse({ error: e.message, query: q }, status);
      }

      return jsonResponse({
        success: (data.count || 0) > 0,
        query: q,
        count: data.count || 0,
        results: data.results || [],
        author: 'Develop by Tridev Cyber Warrior',
      });
    }

    if (path === '/fields') {
      return jsonResponse({ fields: SEARCH_FIELDS, number_fields: NUMBER_FIELDS });
    }

    return jsonResponse({ error: 'not found', path }, 404);
  } catch (e) {
    return jsonResponse({ error: e.message }, 500);
  }
}
